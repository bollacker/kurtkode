@@ -411,3 +411,17 @@ public actor SessionStore {
             .filter { $0.pathExtension == "jsonl" }
     }
 }
+
+extension FileHandle {
+    /// Moves to the end of a JSON Lines file, first ending a torn last line (a crash mid-write) with a newline, so
+    /// the next record starts a line of its own instead of being glued onto the unreadable one. Needs a handle that
+    /// can read (`forUpdating`).
+    func seekToEndOfLastLine() throws {
+        let end = try seekToEnd()
+        guard end > 0 else { return }
+        try seek(toOffset: end - 1)
+        let last = try read(upToCount: 1)
+        try seekToEnd()
+        if last != Data([0x0A]) { try write(contentsOf: Data([0x0A])) }
+    }
+}
